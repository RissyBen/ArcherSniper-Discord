# ===================================================
# ArcherSniper - Environment Variables Configuration
# ===================================================

# Discord Bot Token (Obtained from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Command Prefix (Default: !)
COMMAND_PREFIX=!

# Admin Discord User IDs (Comma-separated numerical IDs)
ADMIN_USER_IDS=673532405134655509

# Optional Default Alert Channel ID
ALERT_CHANNEL_ID=

# Timing & Scraping Intervals (in seconds)
POLL_INTERVAL=15
HEARTBEAT_INTERVAL=60

# Webhook & Health Server Port
PORT=8080

# DLSU Defaults (Campus: 7 = Taft, Term: 155 = AY 24-25 Term 2)
DEFAULT_CAMPUS_NO=7
DEFAULT_ACADEMIC_SESSION=155
